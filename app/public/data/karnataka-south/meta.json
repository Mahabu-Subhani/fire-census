    {
      "id": "C0",
      "name": "The raw record shows the 2012 jump",
      "value": 1.996,
      "threshold": "greater than 0.5",
      "verdict": "pass",
      "note": ""
    },
    {
      "id": "C1",
      "name": "No seam at 2012",
      "value": 0.031,
      "threshold": "absolute value at most 0.10",
      "verdict": "pass",
      "note": ""
    },
    {
      "id": "C1b",
      "name": "No change point at 2012 (Pettitt)",
      "value": "p=0.200 at 2016-04",
      "threshold": "no change point with p < 0.05 between Jul 2011 and Dec 2012",
      "verdict": "pass",
      "note": "38 months with at least 30 Aqua fire cells"
    },
    {
      "id": "C1x",
      "name": "No seam at 2012, out of sample (added after results)",
      "threshold": "absolute log ratio at most 0.10",
      "value": "+0.030",
      "verdict": "pass",
      "note": "Not pre-registered. Fitted on Feb 2015 to Dec 2021 only, tested on Feb 2012 to Jan 2015. Leaving one year out at a time (2012 to 2021): 2 of 10 years within 0.10, mean +0.083, largest 0.434."
    },
    {
      "id": "C2",
      "name": "No seam at placebo dates (2016, 2008)",
      "value": "2016: -0.119; 2008: +0.000",
      "threshold": "absolute value at most 0.10 at both",
      "verdict": "fail",
      "note": "Only the 2016 placebo tests anything: 2008 is zero by construction, because before 2012 the harmonized record is the Aqua reference itself."
    },
    {
      "id": "C3",
      "name": "Held-out years 2018 to 2019",
      "value": 0.288,
      "threshold": "median absolute log ratio at most 0.15",
      "verdict": "fail",
      "note": "7 of 24 months have at least 30 Aqua fire cells"
    },
    {
      "id": "C3r",
      "name": "Held-out years, two-year total (revised after results)",
      "value": -0.196,
      "threshold": "absolute log ratio at most 0.10",
