      "note": "revised held-out check, added after results (PREREGISTRATION.md note of 14 Nov); reported beside C3, never instead of it; 7 months"
    },
    {
      "id": "C3x",
      "name": "Held-out years 2020 to 2021 (added after results)",
      "value": null,
      "threshold": "median absolute log ratio at most 0.15",
      "verdict": "not run",
      "note": "added after results; only 5 months with at least 30 Aqua fire cells"
    },
    {
      "id": "C4",
      "name": "NOAA-20 alone reproduces the record",
      "value": "slope 1.015, correlation 0.976",
      "threshold": "slope 0.90 to 1.10 and correlation at least 0.90",
      "verdict": "pass",
      "note": "103 months"
    },
    {
      "id": "C5",
      "name": "Curve midpoint is physically plausible",
      "value": "day 17.45 MW vs published 5.7 (x3.06); night 3.73 MW vs 3.7 (x1.01)",
      "threshold": "within a factor of 2 of published limits",
      "verdict": "fail",
      "note": "published nadir limits from Sofiev and Kouznetsov (2026), GMD 19, 10123. At the mean Aqua pixel size over this area the published day limit is 8.91 MW"
    },
    {
      "id": "C6",
      "name": "Burned-area relationship is stable",
      "value": 0.347,
      "threshold": "absolute log ratio at most 0.25",
      "verdict": "fail",
      "note": "ESA Fire_cci v5.1 burned area, 2001 to 2020; not pre-registered for this area; reported only. Aqua alone, which has no sensor change, gives 0.34 on the same statistic and the raw record 2.537: the hotspot-to-burned-area relationship itself changed, and our record differs from Aqua's by 0.006. ESA months missing: none"
    },
    {
      "id": "C6m",
      "name": "Same, against NASA MCD64A1 burned area (added after results)",
      "value": 0.438,
      "threshold": "absolute log ratio at most 0.25",
      "verdict": "fail",
      "note": "NASA MCD64A1 C6.1 via Microsoft Planetary Computer; added after results, not pre-registered. 2013 to 2025: 0.835. Aqua alone, with no sensor change: 0.329. Raw record: 2.607"
    },
    {
      "id": "C7",
      "name": "Punjab peak moves later after 2009",
      "value": null,
      "threshold": "at least +5 days, p < 0.05",
      "verdict": "not run",
      "note": "defined for Punjab and Haryana only"
    },
    {
      "id": "C8",
      "name": "Curve is stable under resampling",
      "value": "midpoint 17.5 MW, 90% range 11.7 to 18.8 (width 40% of midpoint)",
      "threshold": "90% range at most 50% of the midpoint",
      "verdict": "pass",
      "note": "applies to the detection curve, which is used for the small-fire layer"
    }
