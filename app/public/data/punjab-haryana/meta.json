    },
    {
      "id": "C6",
      "name": "Burned-area relationship is stable",
      "value": -0.148,
      "threshold": "absolute log ratio at most 0.25",
      "verdict": "pass",
      "note": "ESA Fire_cci v5.1 burned area, 2001 to 2020; reported, not gated: Fire_cci misses many small fires here. Aqua alone, which has no sensor change, gives -0.125 on the same statistic and the raw record 1.553: the hotspot-to-burned-area relationship itself changed, and our record differs from Aqua's by -0.023. ESA months missing: none"
    },
    {
      "id": "C6m",
